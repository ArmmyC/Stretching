        </mxCell>
        <mxCell id="pose" value="PoseTracker&lt;br&gt;&lt;font style=&quot;font-size: 12px;&quot;&gt;MediaPipe primary&lt;br&gt;MoveNet or NCNN fallback&lt;br&gt;Async worker, frame stride, max FPS&lt;br&gt;Flags: visible, centered, full body, arm raised&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#F5F3FF;strokeColor=#7C3AED;fontSize=15;fontStyle=1;spacing=8;" vertex="1" parent="1">
