        <mxCell id="routes" value="HTTP / WS Surface&lt;br&gt;&lt;font style=&quot;font-size: 12px;&quot;&gt;/, /setup, /session, /phone&lt;br&gt;/api/status, /api/session/*, /api/hardware/*&lt;br&gt;/video_feed, /ws/phone-frame, /ws/hardware&lt;br&gt;/qr.png, /summary/*&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#64748B;fontSize=15;fontStyle=1;spacing=8;" vertex="1" parent="1">
