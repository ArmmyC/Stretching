  </diagram>
  <diagram id="startup-config" name="4. Startup and Configuration">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1000" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="title4" value="Startup, Source Selection, and Readiness Logic" style="text;html=1;strokeColor=none;fillColor=none;fontSize=28;fontStyle=1;fontColor=#0F172A;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;" vertex="1" parent="1">
          <mxGeometry x="50" y="30" width="900" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="st1" value="App Lab / local python starts python/main.py" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#E0F2FE;strokeColor=#0369A1;fontSize=15;fontStyle=1;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="70" y="130" width="270" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="st2" value="Default environment values set&lt;br&gt;&lt;font style=&quot;font-size: 12px;&quot;&gt;mediapipe backend, model path, CPU delegate, 320 px inference width, async pose, MoveNet fallback&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#F8FAFC;strokeColor=#475569;fontSize=14;fontStyle=1;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="420" y="115" width="310" height="105" as="geometry"/>
        </mxCell>
        <mxCell id="st3" value="Uvicorn runs app.main:app&lt;br&gt;&lt;font style=&quot;font-size: 12px;&quot;&gt;APP_HOST default 0.0.0.0&lt;br&gt;APP_PORT default 8000&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#FEF3C7;strokeColor=#B45309;fontSize=15;fontStyle=1;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="810" y="130" width="270" height="85" as="geometry"/>
        </mxCell>
        <mxCell id="st4" value="FastAPI startup event&lt;br&gt;&lt;font style=&quot;font-size: 12px;&quot;&gt;log startup&lt;br&gt;hardware_bridge.start()&lt;br&gt;source_manager.start()&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#FFFBEB;strokeColor=#D97706;fontSize=15;fontStyle=1;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="1180" y="125" width="270" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="sel" value="Camera Source Selection Loop" style="swimlane;rounded=1;html=1;startSize=38;arcSize=8;fillColor=#ECFEFF;strokeColor=#0891B2;fontSize=16;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="70" y="305" width="650" height="390" as="geometry"/>
        </mxCell>
        <mxCell id="auto" value="FORCE_CAMERA_MODE=auto&lt;br&gt;&lt;font style=&quot;font-size: 12px;&quot;&gt;Prefer detected USB camera&lt;br&gt;Scan every ~4 seconds&lt;br&gt;Fallback to PHONE_QR&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#0891B2;fontSize=14;fontStyle=1;spacing=8;" vertex="1" parent="sel">
          <mxGeometry x="40" y="80" width="175" height="115" as="geometry"/>
        </mxCell>
        <mxCell id="usbmode" value="FORCE_CAMERA_MODE=usb&lt;br&gt;&lt;font style=&quot;font-size: 12px;&quot;&gt;Scan USB every ~3 seconds&lt;br&gt;Selected source is USB_CAMERA or NO_CAMERA&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#0891B2;fontSize=14;fontStyle=1;spacing=8;" vertex="1" parent="sel">
          <mxGeometry x="240" y="80" width="175" height="115" as="geometry"/>
        </mxCell>
        <mxCell id="phonemode" value="FORCE_CAMERA_MODE=phone&lt;br&gt;&lt;font style=&quot;font-size: 12px;&quot;&gt;Always select PHONE_QR&lt;br&gt;Wait until phone client connects&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#15803D;fontSize=14;fontStyle=1;spacing=8;" vertex="1" parent="sel">
          <mxGeometry x="440" y="80" width="175" height="115" as="geometry"/>
        </mxCell>
        <mxCell id="statusbox" value="Source status emitted through full_status()&lt;br&gt;&lt;font style=&quot;font-size: 12px;&quot;&gt;selected_camera_source, camera_state, connection_status, source_label, FPS, frame dimensions, phone client counts&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#F8FAFC;strokeColor=#475569;fontSize=14;fontStyle=1;spacing=8;" vertex="1" parent="sel">
          <mxGeometry x="120" y="245" width="410" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="ready" value="Setup Boundary Readiness" style="swimlane;rounded=1;html=1;startSize=38;arcSize=8;fillColor=#F5F3FF;strokeColor=#7C3AED;fontSize=16;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="790" y="305" width="660" height="390" as="geometry"/>
        </mxCell>
        <mxCell id="rb1" value="Camera must be ACTIVE&lt;br&gt;&lt;font style=&quot;font-size: 12px;&quot;&gt;Otherwise NO_CAMERA or WAITING_FOR_CAMERA&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#7C3AED;fontSize=14;fontStyle=1;spacing=8;" vertex="1" parent="ready">
          <mxGeometry x="40" y="75" width="180" height="85" as="geometry"/>
        </mxCell>
        <mxCell id="rb2" value="Pose model ready and fresh&lt;br&gt;&lt;font style=&quot;font-size: 12px;&quot;&gt;pose_enabled, model_loaded, last_pose age &lt;= 2 sec&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#7C3AED;fontSize=14;fontStyle=1;spacing=8;" vertex="1" parent="ready">
          <mxGeometry x="250" y="75" width="180" height="85" as="geometry"/>
        </mxCell>
        <mxCell id="rb3" value="Human position checks&lt;br&gt;&lt;font style=&quot;font-size: 12px;&quot;&gt;user_visible&lt;br&gt;torso_centered&lt;br&gt;full_body_visible&lt;br&gt;confidence >= 0.45&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#7C3AED;fontSize=14;fontStyle=1;spacing=8;" vertex="1" parent="ready">
          <mxGeometry x="460" y="75" width="160" height="115" as="geometry"/>
        </mxCell>
        <mxCell id="rb4" value="READY_TO_START&lt;br&gt;&lt;font style=&quot;font-size: 12px;&quot;&gt;session.js holds ready state for 900 ms, then POSTs /api/session/start&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#DCFCE7;strokeColor=#15803D;fontSize=14;fontStyle=1;spacing=8;" vertex="1" parent="ready">
          <mxGeometry x="200" y="260" width="270" height="85" as="geometry"/>
        </mxCell>
        <mxCell id="ops" value="Operational Notes&lt;br&gt;&lt;font style=&quot;font-size: 12px;&quot;&gt;The app is intentionally local-first: no database or cloud service is required. Captures are memory-resident, so restarting the process clears shared photos. The browser keeps the session moving through polling and REST calls, while the video stream is a separate MJPEG response. Hardware input is optional; keyboard controls provide a browser-side fallback.&lt;/font&gt;" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;fillColor=#F8FAFC;strokeColor=#475569;fontSize=15;fontStyle=1;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="70" y="765" width="1380" height="115" as="geometry"/>
        </mxCell>
        <mxCell id="sedge1" value="" style="endArrow=block;html=1;rounded=0;strokeWidth=2;strokeColor=#0369A1;" edge="1" parent="1" source="st1" target="st2">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="sedge2" value="" style="endArrow=block;html=1;rounded=0;strokeWidth=2;strokeColor=#B45309;" edge="1" parent="1" source="st2" target="st3">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="sedge3" value="" style="endArrow=block;html=1;rounded=0;strokeWidth=2;strokeColor=#D97706;" edge="1" parent="1" source="st3" target="st4">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="sedge4" value="Starts source loop" style="endArrow=block;html=1;rounded=0;strokeWidth=2;strokeColor=#0891B2;fontSize=12;" edge="1" parent="1" source="st4" target="sel">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="sedge5" value="Status feeds readiness" style="endArrow=block;html=1;rounded=0;strokeWidth=2;strokeColor=#7C3AED;fontSize=12;" edge="1" parent="1" source="st4" target="ready">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="sedge6" value="" style="endArrow=block;html=1;rounded=0;strokeWidth=2;strokeColor=#475569;" edge="1" parent="sel" source="auto" target="statusbox">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="sedge7" value="" style="endArrow=block;html=1;rounded=0;strokeWidth=2;strokeColor=#475569;" edge="1" parent="sel" source="usbmode" target="statusbox">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="sedge8" value="" style="endArrow=block;html=1;rounded=0;strokeWidth=2;strokeColor=#475569;" edge="1" parent="sel" source="phonemode" target="statusbox">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="redge1" value="" style="endArrow=block;html=1;rounded=0;strokeWidth=2;strokeColor=#7C3AED;" edge="1" parent="ready" source="rb1" target="rb2">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="redge2" value="" style="endArrow=block;html=1;rounded=0;strokeWidth=2;strokeColor=#7C3AED;" edge="1" parent="ready" source="rb2" target="rb3">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="redge3" value="" style="endArrow=block;html=1;rounded=0;strokeWidth=2;strokeColor=#15803D;" edge="1" parent="ready" source="rb3" target="rb4">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
      </root>
