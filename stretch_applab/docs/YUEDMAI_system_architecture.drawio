          <mxGeometry x="905" y="275" width="240" height="110" as="geometry"/>
        </mxCell>
        <mxCell id="phonesource" value="PhoneCameraSource&lt;br&gt;&lt;font style=&quot;font-size: 12px;&quot;&gt;WebSocket client tracking&lt;br&gt;JPEG decode with OpenCV&lt;br&gt;Frames received / decode errors&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#DCFCE7;strokeColor=#15803D;fontSize=14;fontStyle=1;spacing=8;" vertex="1" parent="1">
