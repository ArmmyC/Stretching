        </mxCell>
        <mxCell id="templates" value="Templates + Static Assets&lt;br&gt;&lt;font style=&quot;font-size: 12px;&quot;&gt;landing/setup/session/phone/captures HTML&lt;br&gt;setup.js, session.js, hardware.js, landing.js, style.css&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#DBEAFE;strokeColor=#1D4ED8;fontSize=15;fontStyle=1;spacing=8;" vertex="1" parent="1">
