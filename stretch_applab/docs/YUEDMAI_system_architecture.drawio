          <mxGeometry x="275" y="185" width="170" height="65" as="geometry"/>
        </mxCell>
        <mxCell id="s5" value="PoseTracker metrics&lt;br&gt;&lt;font style=&quot;font-size: 12px;&quot;&gt;visibility, full body, centered, confidence&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#F5F3FF;strokeColor=#7C3AED;fontSize=13;" vertex="1" parent="dfserver">
          <mxGeometry x="275" y="300" width="170" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="s6" value="Encoded JPEG boundary frames&lt;br&gt;&lt;font style=&quot;font-size: 12px;&quot;&gt;multipart/x-mixed-replace&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#B45309;fontSize=13;" vertex="1" parent="dfserver">
          <mxGeometry x="55" y="315" width="180" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="ui1" value="session.html&lt;br&gt;&lt;font style=&quot;font-size: 12px;&quot;&gt;&lt;img src=/video_feed&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#1D4ED8;fontSize=13;" vertex="1" parent="dfui">
          <mxGeometry x="55" y="70" width="150" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="ui2" value="session.js polls /api/status every 500ms" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#1D4ED8;fontSize=13;" vertex="1" parent="dfui">
          <mxGeometry x="230" y="70" width="120" height="85" as="geometry"/>
        </mxCell>
        <mxCell id="ui3" value="Boundary precheck&lt;br&gt;&lt;font style=&quot;font-size: 12px;&quot;&gt;setup.ready after fresh pose + full body + confidence&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#1D4ED8;fontSize=13;" vertex="1" parent="dfui">
          <mxGeometry x="55" y="195" width="150" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="ui4" value="/api/session/start, pause, next, reset" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#1D4ED8;fontSize=13;" vertex="1" parent="dfui">
          <mxGeometry x="230" y="205" width="120" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="ui5" value="Canvas photo capture&lt;br&gt;&lt;font style=&quot;font-size: 12px;&quot;&gt;GOOD / DONE states&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#C2410C;fontSize=13;" vertex="1" parent="dfui">
          <mxGeometry x="55" y="345" width="150" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="ui6" value="/api/session/captures&lt;br&gt;&lt;font style=&quot;font-size: 12px;&quot;&gt;CaptureStore + summary URL&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#FFF7ED;strokeColor=#C2410C;fontSize=13;" vertex="1" parent="dfui">
          <mxGeometry x="230" y="345" width="120" height="85" as="geometry"/>
        </mxCell>
        <mxCell id="hflow" value="Hardware Event Flow&lt;br&gt;&lt;font style=&quot;font-size: 12px;&quot;&gt;UNO Q Bridge hardware_event -> HardwareBridge.publish() -> /ws/hardware -> hardware.js -> YUEDMAI:hardware DOM event -> setup/session handlers. Browser posts feedback to /api/hardware/feedback, which can call set_feedback through the Arduino bridge.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#FCE7F3;strokeColor=#BE185D;fontSize=15;fontStyle=1;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="60" y="720" width="680" height="130" as="geometry"/>
        </mxCell>
        <mxCell id="summaryflow" value="Capture Sharing Flow&lt;br&gt;&lt;font style=&quot;font-size: 12px;&quot;&gt;CaptureStore.reset() creates a short session id. Captures are stored in memory by stretch index after base64 validation and 6 MB size guard. The summary page serves /summary/{session_id}, individual images, a QR code, and /summary/{session_id}/download.zip.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#FFF7ED;strokeColor=#C2410C;fontSize=15;fontStyle=1;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="800" y="720" width="710" height="130" as="geometry"/>
        </mxCell>
        <mxCell id="d1" value="JPEG bytes" style="endArrow=block;html=1;rounded=0;strokeWidth=2;strokeColor=#15803D;fontSize=12;" edge="1" parent="dfphone" source="p1" target="p2">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="d2" value="Frames" style="endArrow=block;html=1;rounded=0;strokeWidth=2;strokeColor=#0891B2;fontSize=12;" edge="1" parent="dfusb" source="u1" target="u2">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="d3" value="Decoded / read frames" style="endArrow=block;html=1;rounded=0;strokeWidth=2;strokeColor=#B45309;fontSize=12;" edge="1" parent="dfserver" source="s1" target="s2">
          <mxGeometry relative="1" as="geometry"/>
