        </mxCell>
        <mxCell id="models2" value="Pose Backends + Assets&lt;br&gt;&lt;font style=&quot;font-size: 12px;&quot;&gt;MediaPipe pose_landmarker.task&lt;br&gt;MoveNet TFLite&lt;br&gt;NCNN YOLO pose / Vulkan or CPU&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#FAF5FF;strokeColor=#9333EA;fontSize=14;fontStyle=1;spacing=8;" vertex="1" parent="1">
