        </mxCell>
        <mxCell id="d6" value="Metrics cached for status" style="endArrow=block;html=1;rounded=0;strokeWidth=2;strokeColor=#7C3AED;fontSize=12;" edge="1" parent="dfserver" source="s4" target="s5">
