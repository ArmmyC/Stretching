        </mxCell>
        <mxCell id="store" value="LatestFrameStore&lt;br&gt;&lt;font style=&quot;font-size: 12px;&quot;&gt;Thread-safe latest frame copy&lt;br&gt;FPS, width, height, timestamp&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#F8FAFC;strokeColor=#475569;fontSize=14;fontStyle=1;spacing=8;" vertex="1" parent="1">
