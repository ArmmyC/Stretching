        </mxCell>
        <mxCell id="inference" value="inference.py&lt;br&gt;&lt;font style=&quot;font-size: 12px;&quot;&gt;process_frame()&lt;br&gt;Adds labels, score, pose metrics&lt;br&gt;Exposes get_pose_status()&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#EDE9FE;strokeColor=#6D28D9;fontSize=15;fontStyle=1;spacing=8;" vertex="1" parent="1">
