        </mxCell>
        <mxCell id="source" value="SourceManager&lt;br&gt;&lt;font style=&quot;font-size: 12px;&quot;&gt;Auto/forced camera mode&lt;br&gt;Background source selection loop&lt;br&gt;Current source status + latest frame&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#ECFEFF;strokeColor=#0891B2;fontSize=15;fontStyle=1;spacing=8;" vertex="1" parent="1">
