          <mxGeometry x="270" y="65" width="220" height="115" as="geometry"/>
        </mxCell>
        <mxCell id="a-nano-states" value="Nano States&lt;br&gt;&lt;font style=&quot;font-size: 12px;&quot;&gt;NANO_ARM_LOW&lt;br&gt;NANO_ARM_RAISED&lt;br&gt;NANO_HOLD_STABLE&lt;br&gt;NANO_UNSTABLE&lt;br&gt;NANO_CALIBRATING&lt;br&gt;NANO_ERROR&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#15803D;fontSize=13;" vertex="1" parent="a-nano">
          <mxGeometry x="25" y="205" width="220" height="135" as="geometry"/>
        </mxCell>
        <mxCell id="a-nano-output" value="Nano Outputs and Commands&lt;br&gt;&lt;font style=&quot;font-size: 12px;&quot;&gt;Serial 115200&lt;br&gt;OUTPUT_JSON 20 Hz compact&lt;br&gt;OUTPUT_FULL_JSON 10 Hz dashboard&lt;br&gt;OUTPUT_PLOTTER labelled numeric series&lt;br&gt;BLE notify 10 Hz compact&lt;br&gt;commands: CALIBRATE, STATUS, SET_ARM_THRESHOLD, SET_STABILITY_THRESHOLD, PLOTTER_ON/OFF&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#15803D;fontSize=13;" vertex="1" parent="a-nano">
          <mxGeometry x="270" y="205" width="220" height="170" as="geometry"/>
