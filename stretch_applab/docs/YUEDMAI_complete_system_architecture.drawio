        </mxCell>
        <mxCell id="p-pose" value="PoseTracker&lt;br&gt;&lt;font style=&quot;font-size: 12px;&quot;&gt;MediaPipe primary backend&lt;br&gt;async worker, frame stride, max FPS&lt;br&gt;computes user_visible, full_body_visible, upper_body_visible, arm_raised, torso_centered, confidence&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#F5F3FF;strokeColor=#7C3AED;fontSize=15;fontStyle=1;spacing=8;" vertex="1" parent="1">
