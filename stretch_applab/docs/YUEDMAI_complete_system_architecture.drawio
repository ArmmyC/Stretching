          <mxGeometry x="25" y="215" width="220" height="115" as="geometry"/>
        </mxCell>
        <mxCell id="a-applab-ble" value="Optional Nano BLE Central&lt;br&gt;&lt;font style=&quot;font-size: 12px;&quot;&gt;USE_NANO_BLE_IMU defaults 0&lt;br&gt;off by default to avoid RouterBridge stalls&lt;br&gt;can scan YUEDMAI-NanoIMU and forward nano_imu&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#0891B2;fontSize=13;" vertex="1" parent="a-applab">
