        <mxCell id="a-hub-sm" value="Fusion State Machine&lt;br&gt;&lt;font style=&quot;font-size: 12px;&quot;&gt;source freshness windows 1000 ms&lt;br&gt;distance range checks&lt;br&gt;hold timer and debounce&lt;br&gt;bad form reset&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#D97706;fontSize=13;" vertex="1" parent="a-hub">
