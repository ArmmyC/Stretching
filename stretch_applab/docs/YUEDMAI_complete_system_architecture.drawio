  <diagram id="browser-api" name="3. Browser UI and API Surface">
    <mxGraphModel dx="2200" dy="1400" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="b-title" value="Browser Pages, Static Assets, API Surface, and User Flows" style="text;html=1;strokeColor=none;fillColor=none;fontSize=28;fontStyle=1;fontColor=#0F172A;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;" vertex="1" parent="1">
          <mxGeometry x="40" y="30" width="1280" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="b-pages" value="Server Rendered Pages" style="swimlane;rounded=1;html=1;startSize=38;arcSize=8;fillColor=#DBEAFE;strokeColor=#1D4ED8;fontSize=16;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="55" y="115" width="350" height="600" as="geometry"/>
        </mxCell>
        <mxCell id="b-landing" value="/ landing.html&lt;br&gt;&lt;font style=&quot;font-size: 12px;&quot;&gt;choose before/after workout&lt;br&gt;hardware page = landing&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#1D4ED8;fontSize=13;" vertex="1" parent="b-pages">
          <mxGeometry x="25" y="65" width="300" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="b-setup" value="/setup setup.html&lt;br&gt;&lt;font style=&quot;font-size: 12px;&quot;&gt;mode, body focus, duration&lt;br&gt;camera preview or phone QR&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#1D4ED8;fontSize=13;" vertex="1" parent="b-pages">
          <mxGeometry x="25" y="155" width="300" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="b-session" value="/session session.html&lt;br&gt;&lt;font style=&quot;font-size: 12px;&quot;&gt;camera-first stretch UI&lt;br&gt;boundary precheck, countdown, rest guide, completion, summary QR&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#1D4ED8;fontSize=13;" vertex="1" parent="b-pages">
          <mxGeometry x="25" y="255" width="300" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="b-dashboard" value="/dashboard dashboard.html&lt;br&gt;&lt;font style=&quot;font-size: 12px;&quot;&gt;analytics-style live session dashboard&lt;br&gt;polls status, listens to nano/hardware events&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#1D4ED8;fontSize=13;" vertex="1" parent="b-pages">
          <mxGeometry x="25" y="375" width="300" height="85" as="geometry"/>
        </mxCell>
        <mxCell id="b-phone" value="/phone phone.html&lt;br&gt;&lt;font style=&quot;font-size: 12px;&quot;&gt;phone camera sender&lt;br&gt;WebSocket reconnect loop&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#15803D;fontSize=13;" vertex="1" parent="b-pages">
          <mxGeometry x="25" y="480" width="300" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="b-captures" value="/summary/{session_id} captures.html&lt;br&gt;&lt;font style=&quot;font-size: 12px;&quot;&gt;photo gallery, individual downloads, ZIP download&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#C2410C;fontSize=13;" vertex="1" parent="b-pages">
          <mxGeometry x="25" y="570" width="300" height="75" as="geometry"/>
        </mxCell>
        <mxCell id="b-js" value="Static JavaScript and CSS" style="swimlane;rounded=1;html=1;startSize=38;arcSize=8;fillColor=#F8FAFC;strokeColor=#475569;fontSize=16;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="455" y="115" width="390" height="600" as="geometry"/>
        </mxCell>
        <mxCell id="b-hardwarejs" value="hardware.js&lt;br&gt;&lt;font style=&quot;font-size: 12px;&quot;&gt;connects /ws/hardware&lt;br&gt;dispatches YUEDMAI:hardware DOM events&lt;br&gt;keyboard fallback controls&lt;br&gt;POSTs /api/hardware/feedback&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#FCE7F3;strokeColor=#BE185D;fontSize=13;" vertex="1" parent="b-js">
          <mxGeometry x="25" y="60" width="340" height="105" as="geometry"/>
        </mxCell>
        <mxCell id="b-landingjs" value="landing.js + setup.js&lt;br&gt;&lt;font style=&quot;font-size: 12px;&quot;&gt;hardware navigation&lt;br&gt;choice focus ring&lt;br&gt;form hidden fields for mode/focus/duration&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#475569;fontSize=13;" vertex="1" parent="b-js">
          <mxGeometry x="25" y="185" width="340" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="b-sessionjs" value="session.js&lt;br&gt;&lt;font style=&quot;font-size: 12px;&quot;&gt;polls /api/status every 500 ms&lt;br&gt;boundary precheck and auto-start&lt;br&gt;POST /api/session/start|pause|next|reset&lt;br&gt;captures MJPEG image to canvas and uploads photos&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#1D4ED8;fontSize=13;" vertex="1" parent="b-js">
          <mxGeometry x="25" y="295" width="340" height="125" as="geometry"/>
        </mxCell>
        <mxCell id="b-dashjs" value="dashboard.js&lt;br&gt;&lt;font style=&quot;font-size: 12px;&quot;&gt;polls /api/status?debug=1&lt;br&gt;updates synthetic and live analytics panels&lt;br&gt;listens to YUEDMAI:nano-imu and hardware events&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#0369A1;fontSize=13;" vertex="1" parent="b-js">
          <mxGeometry x="25" y="440" width="340" height="95" as="geometry"/>
        </mxCell>
        <mxCell id="b-style" value="style.css + dashboard.css + sounds.js&lt;br&gt;&lt;font style=&quot;font-size: 12px;&quot;&gt;kiosk layout, overlays, controls, summary gallery&lt;br&gt;button/complete/stretch audio cues&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#475569;fontSize=13;" vertex="1" parent="b-js">
          <mxGeometry x="25" y="555" width="340" height="85" as="geometry"/>
        </mxCell>
        <mxCell id="b-api" value="FastAPI Route Surface" style="swimlane;rounded=1;html=1;startSize=38;arcSize=8;fillColor=#FEF3C7;strokeColor=#B45309;fontSize=16;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="900" y="115" width="385" height="600" as="geometry"/>
        </mxCell>
        <mxCell id="b-api-pages" value="Pages&lt;br&gt;&lt;font style=&quot;font-size: 12px;&quot;&gt;GET /, /setup, /session, /dashboard, /phone&lt;br&gt;GET /summary/{session_id}&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#B45309;fontSize=13;" vertex="1" parent="b-api">
          <mxGeometry x="25" y="60" width="335" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="b-api-streams" value="Streams and QR&lt;br&gt;&lt;font style=&quot;font-size: 12px;&quot;&gt;GET /video_feed?overlay=0|1&lt;br&gt;GET /qr.png&lt;br&gt;GET /summary_qr/{session_id}.png&lt;br&gt;WS /ws/phone-frame, /ws/hardware&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#0891B2;fontSize=13;" vertex="1" parent="b-api">
          <mxGeometry x="25" y="160" width="335" height="105" as="geometry"/>
        </mxCell>
        <mxCell id="b-api-status" value="Status and Health&lt;br&gt;&lt;font style=&quot;font-size: 12px;&quot;&gt;GET /api/status?debug=1&lt;br&gt;GET /api/health&lt;br&gt;GET /api/hardware&lt;br&gt;POST /api/rescan_usb&lt;br&gt;POST /api/nano_imu&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#64748B;fontSize=13;" vertex="1" parent="b-api">
          <mxGeometry x="25" y="285" width="335" height="115" as="geometry"/>
        </mxCell>
        <mxCell id="b-api-session" value="Session Controls&lt;br&gt;&lt;font style=&quot;font-size: 12px;&quot;&gt;POST /api/session/start&lt;br&gt;POST /api/session/pause&lt;br&gt;POST /api/session/next&lt;br&gt;POST /api/session/reset&lt;br&gt;POST /api/session/config&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#D97706;fontSize=13;" vertex="1" parent="b-api">
          <mxGeometry x="25" y="420" width="335" height="105" as="geometry"/>
        </mxCell>
        <mxCell id="b-api-capture" value="Capture Sharing&lt;br&gt;&lt;font style=&quot;font-size: 12px;&quot;&gt;POST /api/session/captures&lt;br&gt;GET /summary/{session_id}/image/{index}.{ext}&lt;br&gt;GET /summary/{session_id}/download.zip&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#FFF7ED;strokeColor=#C2410C;fontSize=13;" vertex="1" parent="b-api">
          <mxGeometry x="25" y="545" width="335" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="b-flow" value="Primary Browser Flow" style="swimlane;rounded=1;html=1;startSize=38;arcSize=8;fillColor=#EEF2FF;strokeColor=#4F46E5;fontSize=16;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1340" y="115" width="390" height="600" as="geometry"/>
        </mxCell>
        <mxCell id="b-flow1" value="1. Landing selection&lt;br&gt;&lt;font style=&quot;font-size: 12px;&quot;&gt;before or after workout&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#4F46E5;fontSize=13;" vertex="1" parent="b-flow">
          <mxGeometry x="25" y="65" width="335" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="b-flow2" value="2. Setup configuration&lt;br&gt;&lt;font style=&quot;font-size: 12px;&quot;&gt;mode, body_focus, duration&lt;br&gt;camera preview or phone QR fallback&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#4F46E5;fontSize=13;" vertex="1" parent="b-flow">
          <mxGeometry x="25" y="145" width="335" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="b-flow3" value="3. Boundary precheck&lt;br&gt;&lt;font style=&quot;font-size: 12px;&quot;&gt;camera active + fresh pose + full body/upper body + centered + confidence&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#7C3AED;fontSize=13;" vertex="1" parent="b-flow">
          <mxGeometry x="25" y="245" width="335" height="85" as="geometry"/>
        </mxCell>
        <mxCell id="b-flow4" value="4. Stretch session loop&lt;br&gt;&lt;font style=&quot;font-size: 12px;&quot;&gt;READY, HOLD, GOOD, REST, DONE&lt;br&gt;MJPEG stream and /api/status are separate browser flows&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#D97706;fontSize=13;" vertex="1" parent="b-flow">
          <mxGeometry x="25" y="350" width="335" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="b-flow5" value="5. Completion and sharing&lt;br&gt;&lt;font style=&quot;font-size: 12px;&quot;&gt;session.js stores captures locally and uploads them&lt;br&gt;summary QR opens capture gallery or ZIP download&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#C2410C;fontSize=13;" vertex="1" parent="b-flow">
          <mxGeometry x="25" y="460" width="335" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="b-hwflow" value="Hardware UI Loop&lt;br&gt;&lt;font style=&quot;font-size: 12px;&quot;&gt;App Lab MCU sketch -> Bridge hardware_event -> HardwareBridge -> /ws/hardware -> hardware.js -> DOM events. Browser feedback posts page/state/selection/value to /api/hardware/feedback and can update pixels/LEDs through set_feedback.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#FCE7F3;strokeColor=#BE185D;fontSize=15;fontStyle=1;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="55" y="785" width="790" height="110" as="geometry"/>
        </mxCell>
        <mxCell id="b-captureflow" value="Capture Store Behavior&lt;br&gt;&lt;font style=&quot;font-size: 12px;&quot;&gt;CaptureStore.reset() creates a short share id. Captures are indexed by stretch, kept in process memory, validated as PNG/JPEG/WebP data URLs, and cleared on app restart or session reset/config changes.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#FFF7ED;strokeColor=#C2410C;fontSize=15;fontStyle=1;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="900" y="785" width="830" height="110" as="geometry"/>
        </mxCell>
        <mxCell id="b-e1" value="renders" style="endArrow=block;html=1;rounded=0;strokeWidth=2;strokeColor=#1D4ED8;fontSize=12;" edge="1" parent="1" source="b-api-pages" target="b-pages">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="b-e2" value="loaded by pages" style="endArrow=block;html=1;rounded=0;strokeWidth=2;strokeColor=#475569;fontSize=12;" edge="1" parent="1" source="b-js" target="b-pages">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="b-e3" value="REST/WS/MJPEG" style="endArrow=block;html=1;rounded=0;strokeWidth=2;strokeColor=#B45309;fontSize=12;" edge="1" parent="1" source="b-js" target="b-api">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="b-e4" value="drives user state" style="endArrow=block;html=1;rounded=0;strokeWidth=2;strokeColor=#4F46E5;fontSize=12;" edge="1" parent="1" source="b-pages" target="b-flow">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="vision-scoring" name="4. Vision, Pose, and Scoring">
    <mxGraphModel dx="2200" dy="1400" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="v-title" value="Vision Pipeline, Pose Metrics, Boundary Readiness, and Stretch Scoring" style="text;html=1;strokeColor=none;fillColor=none;fontSize=28;fontStyle=1;fontColor=#0F172A;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;" vertex="1" parent="1">
          <mxGeometry x="40" y="30" width="1400" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="v-usb" value="USB Camera Path&lt;br&gt;&lt;font style=&quot;font-size: 12px;&quot;&gt;USBCameraSource&lt;br&gt;cv2.VideoCapture.read()&lt;br&gt;frame validation and reconnect&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#ECFEFF;strokeColor=#0891B2;fontSize=15;fontStyle=1;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="55" y="130" width="240" height="110" as="geometry"/>
        </mxCell>
        <mxCell id="v-phone" value="Phone Camera Path&lt;br&gt;&lt;font style=&quot;font-size: 12px;&quot;&gt;phone.html captures browser camera&lt;br&gt;JPEG blobs to /ws/phone-frame&lt;br&gt;PhoneCameraSource decodes bytes&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#DCFCE7;strokeColor=#15803D;fontSize=15;fontStyle=1;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="55" y="300" width="240" height="120" as="geometry"/>
        </mxCell>
        <mxCell id="v-source" value="SourceManager Decision&lt;br&gt;&lt;font style=&quot;font-size: 12px;&quot;&gt;auto: prefer USB then phone QR&lt;br&gt;usb: only USB or NO_CAMERA&lt;br&gt;phone: always PHONE_QR&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#F0FDFA;strokeColor=#0F766E;fontSize=15;fontStyle=1;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="375" y="210" width="250" height="115" as="geometry"/>
