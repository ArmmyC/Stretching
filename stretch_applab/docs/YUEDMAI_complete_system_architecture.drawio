        <mxCell id="a-hub-inputs" value="Hub Inputs&lt;br&gt;&lt;font style=&quot;font-size: 12px;&quot;&gt;camera_pose JSON from Linux/Python over USB Serial&lt;br&gt;nano_imu JSON from Serial1, USB forward, or BLE&lt;br&gt;ModulinoDistance or mock distance&lt;br&gt;buttons for manual controls&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#D97706;fontSize=13;" vertex="1" parent="a-hub">
          <mxGeometry x="25" y="65" width="230" height="130" as="geometry"/>
