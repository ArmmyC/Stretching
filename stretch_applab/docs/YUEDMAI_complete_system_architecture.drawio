        <mxCell id="p-main" value="app/main.py FastAPI App&lt;br&gt;&lt;font style=&quot;font-size: 12px;&quot;&gt;startup/shutdown&lt;br&gt;routes and WebSockets&lt;br&gt;full_status(), setup boundary readiness&lt;br&gt;MJPEG generator and capture summaries&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#FEF3C7;strokeColor=#B45309;fontSize=16;fontStyle=1;spacing=8;" vertex="1" parent="1">
