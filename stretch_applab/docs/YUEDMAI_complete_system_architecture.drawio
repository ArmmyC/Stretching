        <mxCell id="p-utils" value="utils.py&lt;br&gt;&lt;font style=&quot;font-size: 12px;&quot;&gt;logging to logs/app.log&lt;br&gt;PUBLIC_BASE_URL or local IP base URL&lt;br&gt;QR PNG generation&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#F8FAFC;strokeColor=#475569;fontSize=14;fontStyle=1;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="680" y="725" width="230" height="115" as="geometry"/>
