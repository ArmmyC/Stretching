        </mxCell>
        <mxCell id="v-infer" value="inference.process_frame()&lt;br&gt;&lt;font style=&quot;font-size: 12px;&quot;&gt;draw labels: source, FPS, time, state, score&lt;br&gt;optionally draws pose landmarks&lt;br&gt;returns processed frame + metrics&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#EDE9FE;strokeColor=#6D28D9;fontSize=15;fontStyle=1;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="1280" y="165" width="265" height="135" as="geometry"/>
