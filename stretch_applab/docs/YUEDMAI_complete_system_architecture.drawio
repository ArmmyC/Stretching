          <mxGeometry x="285" y="65" width="220" height="115" as="geometry"/>
        </mxCell>
        <mxCell id="v-side" value="side_bend model&lt;br&gt;&lt;font style=&quot;font-size: 12px;&quot;&gt;overhead reach, lateral tilt, elbow extension, side reach&lt;br&gt;78 percent pose, optional Nano arm/stability&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#C2410C;fontSize=13;" vertex="1" parent="v-score">
