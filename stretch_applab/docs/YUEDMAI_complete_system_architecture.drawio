        <mxCell id="p-status" value="full_status(debug)&lt;br&gt;&lt;font style=&quot;font-size: 12px;&quot;&gt;camera + pose + session + setup + hardware + nano_ble + captures&lt;br&gt;debug adds extra pose/backend details&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#64748B;fontSize=15;fontStyle=1;spacing=8;" vertex="1" parent="1">
