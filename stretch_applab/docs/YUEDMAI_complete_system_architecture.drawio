        <mxCell id="p-hardware" value="HardwareBridge&lt;br&gt;&lt;font style=&quot;font-size: 12px;&quot;&gt;optional arduino.app_utils.Bridge adapter&lt;br&gt;Bridge.provide hardware_event + nano_imu&lt;br&gt;/ws/hardware fanout&lt;br&gt;/api/hardware/feedback to set_feedback&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#FCE7F3;strokeColor=#BE185D;fontSize=15;fontStyle=1;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="55" y="725" width="270" height="145" as="geometry"/>
        </mxCell>
        <mxCell id="p-nanoble" value="nano_ble.py&lt;br&gt;&lt;font style=&quot;font-size: 12px;&quot;&gt;NANO_BLE_ENABLED&lt;br&gt;Bleak scan/connect/subscribe&lt;br&gt;receives compact Nano packets&lt;br&gt;feeds HardwareBridge latest_nano_imu&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#ECFEFF;strokeColor=#0891B2;fontSize=15;fontStyle=1;spacing=8;" vertex="1" parent="1">
