        <mxCell id="v-movenet" value="MoveNet TFLite Fallback&lt;br&gt;&lt;font style=&quot;font-size: 12px;&quot;&gt;movenet_pose.py&lt;br&gt;COCO to YUEDMAI landmarks&lt;br&gt;192 px default input&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#9333EA;fontSize=13;" vertex="1" parent="v-pose">
          <mxGeometry x="275" y="60" width="230" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="v-ncnn" value="NCNN YOLO Pose Fallback&lt;br&gt;&lt;font style=&quot;font-size: 12px;&quot;&gt;ncnn_pose.py&lt;br&gt;letterbox + NMS + landmarks&lt;br&gt;optional Vulkan/GPU index&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#9333EA;fontSize=13;" vertex="1" parent="v-pose">
          <mxGeometry x="25" y="170" width="230" height="90" as="geometry"/>
