        <mxCell id="a-applab" value="stretch_applab/sketch/sketch.ino - App Lab MCU Control Sketch" style="swimlane;rounded=1;html=1;startSize=42;arcSize=8;fillColor=#FCE7F3;strokeColor=#BE185D;fontSize=17;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="645" y="120" width="520" height="430" as="geometry"/>
        </mxCell>
