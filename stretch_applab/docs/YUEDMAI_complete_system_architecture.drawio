        <mxCell id="v-pose" value="PoseTracker" style="swimlane;rounded=1;html=1;startSize=38;arcSize=8;fillColor=#F5F3FF;strokeColor=#7C3AED;fontSize=16;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="55" y="510" width="530" height="310" as="geometry"/>
        </mxCell>
        <mxCell id="v-mp" value="MediaPipe Pose Landmarker&lt;br&gt;&lt;font style=&quot;font-size: 12px;&quot;&gt;default POSE_BACKEND=mediapipe&lt;br&gt;models/pose_landmarker.task&lt;br&gt;CPU delegate by default&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#7C3AED;fontSize=13;" vertex="1" parent="v-pose">
          <mxGeometry x="25" y="60" width="230" height="90" as="geometry"/>
