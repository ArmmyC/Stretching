        <mxCell id="p-capture" value="CaptureStore&lt;br&gt;&lt;font style=&quot;font-size: 12px;&quot;&gt;short session id&lt;br&gt;validates base64 images&lt;br&gt;6 MB guard&lt;br&gt;summary page, image endpoint, ZIP download&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#FFF7ED;strokeColor=#C2410C;fontSize=15;fontStyle=1;spacing=8;" vertex="1" parent="1">
