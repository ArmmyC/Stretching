        <mxCell id="v-frame" value="LatestFrameStore&lt;br&gt;&lt;font style=&quot;font-size: 12px;&quot;&gt;selected frame copy&lt;br&gt;frame stats and timestamps&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#F8FAFC;strokeColor=#475569;fontSize=15;fontStyle=1;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="690" y="220" width="215" height="95" as="geometry"/>
        </mxCell>
        <mxCell id="v-mjpeg" value="mjpeg_generator()&lt;br&gt;&lt;font style=&quot;font-size: 12px;&quot;&gt;build context from full_status()&lt;br&gt;uses placeholder_frame() when no camera&lt;br&gt;encodes multipart JPEG stream&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#FEF3C7;strokeColor=#B45309;fontSize=15;fontStyle=1;spacing=8;" vertex="1" parent="1">
