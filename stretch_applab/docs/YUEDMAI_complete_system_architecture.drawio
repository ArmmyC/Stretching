          <mxGeometry x="275" y="170" width="230" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="v-ready" value="Setup Boundary Readiness&lt;br&gt;&lt;font style=&quot;font-size: 12px;&quot;&gt;camera ACTIVE&lt;br&gt;pose enabled + model loaded&lt;br&gt;fresh pose age &lt;= 2 sec&lt;br&gt;user visible + centered + enough body + confidence &gt;= 0.45&lt;br&gt;emits READY_TO_START or specific guidance state&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#DCFCE7;strokeColor=#15803D;fontSize=15;fontStyle=1;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="650" y="520" width="330" height="165" as="geometry"/>
        </mxCell>
        <mxCell id="v-status" value="/api/status Payload&lt;br&gt;&lt;font style=&quot;font-size: 12px;&quot;&gt;camera: selected source/state/FPS&lt;br&gt;pose: metrics and backend status&lt;br&gt;setup: boundary readiness&lt;br&gt;session: routine, phase, score&lt;br&gt;hardware/nano/captures&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#64748B;fontSize=15;fontStyle=1;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="1040" y="520" width="290" height="155" as="geometry"/>
        </mxCell>
        <mxCell id="v-session" value="Session State Machine&lt;br&gt;&lt;font style=&quot;font-size: 12px;&quot;&gt;READY 5 sec&lt;br&gt;HOLD up to 30 sec&lt;br&gt;GOOD near completion&lt;br&gt;REST 10 sec between stretches&lt;br&gt;DONE when routine complete&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#FFFBEB;strokeColor=#D97706;fontSize=15;fontStyle=1;spacing=8;" vertex="1" parent="1">
