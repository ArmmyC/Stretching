        <mxCell id="p-startup" value="Startup Event&lt;br&gt;&lt;font style=&quot;font-size: 12px;&quot;&gt;log_startup_details()&lt;br&gt;hardware_bridge.start()&lt;br&gt;nano_ble_manager.start()&lt;br&gt;source_manager.start()&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#FFFBEB;strokeColor=#D97706;fontSize=14;fontStyle=1;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="650" y="120" width="220" height="120" as="geometry"/>
        </mxCell>
        <mxCell id="p-source" value="SourceManager&lt;br&gt;&lt;font style=&quot;font-size: 12px;&quot;&gt;FORCE_CAMERA_MODE auto/usb/phone&lt;br&gt;background source loop&lt;br&gt;selected_camera_source and camera_state&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#ECFEFF;strokeColor=#0891B2;fontSize=15;fontStyle=1;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="55" y="320" width="240" height="120" as="geometry"/>
        </mxCell>
        <mxCell id="p-usb" value="USBCameraSource&lt;br&gt;&lt;font style=&quot;font-size: 12px;&quot;&gt;cv2.VideoCapture&lt;br&gt;indexes 0-5&lt;br&gt;validation frames&lt;br&gt;disconnect failure threshold&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#F0FDFA;strokeColor=#0F766E;fontSize=14;fontStyle=1;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="55" y="500" width="220" height="120" as="geometry"/>
        </mxCell>
        <mxCell id="p-phone" value="PhoneCameraSource&lt;br&gt;&lt;font style=&quot;font-size: 12px;&quot;&gt;/ws/phone-frame clients&lt;br&gt;JPEG decode with OpenCV&lt;br&gt;client count, decode errors, FPS&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#DCFCE7;strokeColor=#15803D;fontSize=14;fontStyle=1;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="320" y="500" width="220" height="120" as="geometry"/>
        </mxCell>
        <mxCell id="p-frame" value="LatestFrameStore + FrameStats&lt;br&gt;&lt;font style=&quot;font-size: 12px;&quot;&gt;thread-safe frame copy&lt;br&gt;width, height, FPS, timestamp&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#F8FAFC;strokeColor=#475569;fontSize=14;fontStyle=1;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="585" y="500" width="230" height="105" as="geometry"/>
        </mxCell>
        <mxCell id="p-infer" value="inference.py&lt;br&gt;&lt;font style=&quot;font-size: 12px;&quot;&gt;process_frame(frame, context)&lt;br&gt;draw frame labels and pose overlay&lt;br&gt;cache pose metrics for /api/status&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#EDE9FE;strokeColor=#6D28D9;fontSize=15;fontStyle=1;spacing=8;" vertex="1" parent="1">
