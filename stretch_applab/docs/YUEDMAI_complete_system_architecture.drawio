        <mxCell id="p-launch" value="python/main.py&lt;br&gt;&lt;font style=&quot;font-size: 12px;&quot;&gt;App Lab launcher&lt;br&gt;sets pose defaults&lt;br&gt;starts uvicorn app.main:app&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#E0F2FE;strokeColor=#0369A1;fontSize=15;fontStyle=1;spacing=8;" vertex="1" parent="1">
